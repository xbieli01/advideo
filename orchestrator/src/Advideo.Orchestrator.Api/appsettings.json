{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Queue": {
    "Capacity": 1000
  },
  "Worker": {
    "MaxConcurrency": 2
  },
  "Pipeline": {
    "Command": "advideo-analyze",
    "TimeoutSeconds": 3600
  },
  "Storage": {
    "Provider": "filesystem",
    "FileSystem": {
      "RootPath": "./data/maps"
    },
    "S3": {
      "Bucket": "advideo-maps",
      "Prefix": "maps/",
      "ServiceUrl": "http://localhost:9000",
      "ForcePathStyle": true
    }
  }
}
